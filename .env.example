# Copy to .env.<env> (.env.dev, .env.uat, ...) and fill in what you have. Each file is one environment.
# Without envs.json, every DATABASE_URL_<NAME> below becomes database <name> (DATABASE_URL alone: named after the db in the URL).
# With envs.json you can map other variable names; see envs.example.json.

# Postgres (read-only connections are enforced by dt): postgres://user:pass@host:5432/db
DATABASE_URL_ORDERS=
DATABASE_URL_BILLING=

# Elasticsearch (data)
ELASTICSEARCH_HOSTS=http://es-dev:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=

# Kafka via kafka-ui (https://github.com/provectus/kafka-ui) and Schema Registry
KAFKA_UI_URL=
SCHEMA_REGISTRY_URL=

# Consul (service health, deployed /version)
CONSUL_URL=

# ELK logs (logs_search / logs_trace). Without LOGS_ES_HOSTS the data ES cluster + login above are used.
# LOGS_ES_HOSTS=http://elk-host:9200
# LOGS_ES_USER=
# LOGS_ES_PASS=
# LOGS_INDEX=logs-*
# field names in your log documents (defaults are ECS):
# LOGS_FIELD_TIME=@timestamp
# LOGS_FIELD_MESSAGE=message
# LOGS_FIELD_SERVICE=service.name
# LOGS_FIELD_LEVEL=log.level
# LOGS_FIELD_TRACE=trace.id
# LOGS_KIBANA_URL=http://kibana-host:5601
