# Values for config.json (${NAME} references) and docker compose settings. Copy to .env; never commit it.

# ── referenced from config.json ──
DEV_ORDERS_DB_URL=postgres://user:pass@db-dev:5432/orders
DEV_BILLING_DB_URL=
DEV_ES_USER=
DEV_ES_PASSWORD=
DEV_LOGS_USER=
DEV_LOGS_PASSWORD=
UAT_ORDERS_DB_URL=
BITBUCKET_TOKEN=
CONFLUENCE_TOKEN=
# Cloud only: add "user": "${CONFLUENCE_USER}" to confluence in config.json and set type to cloud.
CONFLUENCE_USER=
CI_TOKEN=
PARTNER_SFTP_PASSWORD=
# SFTP key login: config.json privateKeyFile (in the config folder), or privateKey with \n for line breaks
ARCHIVE_SFTP_KEY_PASSPHRASE=
# browser logins: the model types the NAME, the browser container gets the value
CRM_USER=
CRM_PASSWORD=

# ── docker compose ──
# run.sh also upgrades older profile lists to include semantic. --tools-only disables all.
# ./run.sh --no-webui up -d keeps supporting services without bundled chat/setup.
# To keep that choice for plain ./run.sh up -d, omit webui from the list below.
COMPOSE_PROFILES=webui,browser,graph,jdk,testdb,semantic
# LLM for the bundled Open WebUI (OpenAI-compatible, with tool calling)
LLM_BASE_URL=http://llm.internal:8000/v1
LLM_API_KEY=
LLM_MODEL=
# require this key from untrusted clients (set it before DT_BIND=0.0.0.0)
DT_API_KEY=
# DT_BIND=127.0.0.1
# DT_PORT=4000
# WEBUI_PORT=3000
# DT_PUBLIC_URL=http://127.0.0.1:4000
# run.sh enables and builds the semantic worker, supplies its URL and creates its shared token.
# DT_SEMANTIC_ENABLED=0                # opt out, or use ./run.sh --no-semantic up -d
# DT_SEMANTIC_URL=http://semantic:4110
# DT_SEMANTIC_TOKEN=                    # generated once when absent; keep it across updates
# DT_SEMANTIC_CONTAINER_MEMORY=26g
# DT_SEMANTIC_MEMORY_MB=24576

# Optional API explorer bearer reference; bind it to a URL in api.authProfiles.
# DEV_API_BEARER_TOKEN=

# Diagnostic tracing is opt-in per chat in Admin -> Runtime -> Traces & observability.
# Empty endpoint keeps traces local. Export uses OTLP/HTTP JSON, not gRPC.
DT_TELEMETRY_ENABLED=1
OTEL_SERVICE_NAME=dev-tool
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
