# Values for config.json (${NAME} references) and docker compose settings. Copy to .env; never commit it.

# ── referenced from config.json ──
DEV_ORDERS_DB_URL=postgres://user:pass@db-dev:5432/orders
DEV_BILLING_DB_URL=
DEV_ES_USER=
DEV_ES_PASSWORD=
DEV_LOGS_USER=
DEV_LOGS_PASSWORD=
UAT_ORDERS_DB_URL=
BITBUCKET_TOKEN=
CONFLUENCE_USER=
CONFLUENCE_TOKEN=
CI_TOKEN=
PARTNER_SFTP_PASSWORD=
# browser logins: the model types the NAME, the browser container gets the value
CRM_USER=
CRM_PASSWORD=

# ── docker compose ──
# optional parts besides the dt tool server: webui (Open WebUI + setup), browser (Playwright), graph (code-review-graph)
COMPOSE_PROFILES=webui,browser,graph
# LLM for the bundled Open WebUI (OpenAI-compatible, with tool calling)
LLM_BASE_URL=http://llm.internal:8000/v1
LLM_API_KEY=
LLM_MODEL=
# require this key from untrusted clients (set it before DT_BIND=0.0.0.0)
DT_API_KEY=
# DT_BIND=127.0.0.1
# DT_PORT=4000
# WEBUI_PORT=3000
# DT_PUBLIC_URL=http://127.0.0.1:4000
