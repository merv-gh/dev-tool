  {
   "schema": "shop",
   "name": "close_order",
   "kind": "procedure",
   "args": "IN p_id bigint, INOUT p_status text",
   "signature": "IN p_id bigint, INOUT p_status text",
   "returns": null,
   "arg_list": [
    {
     "name": "p_id",
     "type": "bigint",
     "mode": "in"
    },
    {
     "name": "p_status",
     "type": "text",
