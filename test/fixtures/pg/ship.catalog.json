 "functions": [
  {
   "schema": "pay",
   "name": "customer_balance",
   "kind": "function",
   "args": "p_customer bigint",
   "signature": "p_customer bigint",
   "returns": "numeric",
   "arg_list": [
    {
     "name": "p_customer",
     "type": "bigint",
     "mode": "in"
    }
   ],
   "lang": "plpgsql",
   "volatility": "stable",
   "security_definer": false,
   "comment": null,
   "body": "\ndeclare settled numeric; refunded numeric;\nbegin\n  select coalesce(sum(amount - fee), 0) into settled from pay.payments where customer_id = p_customer and status = 'SETTLED';\n  select coalesce(sum(r.amount), 0) into refunded from pay.refunds r join pay.payments p on p.id = r.payment_id where p.customer_id = p_customer;\n  return settled - refunded;\nend "
  },
