{
  "envs": {
    "dev": {
      "postgres": {
        "orders": "${DEV_ORDERS_DB_URL}",
        "billing": "${DEV_BILLING_DB_URL}"
      },
      "defaultDb": "orders",
      "elasticsearch": { "hosts": ["http://es-dev:9200"], "user": "${DEV_ES_USER}", "password": "${DEV_ES_PASSWORD}" },
      "kafkaUi": "http://kafka-ui-dev:8080",
      "schemaRegistry": "http://schema-registry-dev:8081",
      "consul": "http://consul-dev:8500",
      "logs": {
        "hosts": ["http://elk-dev:9200"],
        "user": "${DEV_LOGS_USER}",
        "password": "${DEV_LOGS_PASSWORD}",
        "index": "logs-*",
        "fields": { "time": "@timestamp", "message": "message", "service": "service.name", "level": "log.level", "trace": "trace.id" },
        "kibana": "http://kibana-dev:5601"
      }
    },
    "uat": {
      "postgres": { "orders": "${UAT_ORDERS_DB_URL}" },
      "consul": "http://consul-uat:8500"
    }
  },

  "bitbucket": { "url": "https://bitbucket.example.com", "token": "${BITBUCKET_TOKEN}" },
  "confluence": { "url": "https://confluence.example.com", "user": "${CONFLUENCE_USER}", "token": "${CONFLUENCE_TOKEN}" },
  "passports": { "internalGroups": ["com.example.libs"], "libraryRepos": { "example-starter-*": "LIB/example-starters" } },
  "graph": { "url": "${GRAPH_URL:-http://graph:8000}" },

  "tools": {
    "enable": ["all"],
    "disable": ["confluence"],
    "plugins": [],
    "custom": [
      {
        "name": "orders_by_status",
        "type": "sql",
        "description": "Latest orders with a given status in dev (id, customer, total, created).",
        "env": "dev",
        "db": "orders",
        "sql": "select id, customer_id, total, created_at from sales.orders where status = :status order by created_at desc limit :limit",
        "params": {
          "status": { "type": "string", "required": true, "enum": ["new", "paid", "shipped", "closed"] },
          "limit": { "type": "integer", "default": 50 }
        }
      },
      {
        "name": "ci_builds",
        "type": "http",
        "description": "Recent CI builds of a service (status, branch, commit).",
        "url": "https://ci.example.com/api/projects/{service}/builds",
        "headers": { "authorization": "Bearer ${CI_TOKEN}" },
        "params": { "service": { "type": "string", "required": true }, "branch": { "type": "string" } },
        "rows": "builds"
      }
    ]
  },

  "browser": {
    "sites": {
      "crm": {
        "url": "https://crm.dev.example.com/login", "secrets": ["CRM_USER", "CRM_PASSWORD"],
        "description": "Back office: customers, orders, refunds",
        "links": {
          "customers": "/customers",
          "customer": { "path": "/customers/<customerId>", "description": "One customer: profile, orders, tickets" },
          "order": "/orders/<orderId>",
          "search": "/search?q=<q>"
        }
      }
    },
    "mcp": "${DT_BROWSER_MCP:-}"
  },

  "files": {
    "templates": { "type": "local", "path": "files/templates" },
    "partner": {
      "type": "sftp", "host": "sftp.dev.example.com", "port": 22, "user": "dt", "password": "${PARTNER_SFTP_PASSWORD}",
      "root": "/upload", "write": true
    },
    "archive": {
      "type": "sftp", "host": "files.dev.example.com", "user": "dt-reader",
      "privateKeyFile": "keys/archive_ed25519", "passphrase": "${ARCHIVE_SFTP_KEY_PASSPHRASE:-}",
      "hostKey": "SHA256:AAAAC3NzaC1lZDI1NTE5AAAAIExampleHostKeyFingerprint00",
      "root": "/exports"
    }
  },

  "scripts": { "http": { "allow": ["https://partner-api.dev.example.com/imports"] }, "js": true, "jsTimeoutMs": 5000 },

  "timeouts": { "pgQueryMs": 60000, "pgIndexMs": 120000, "catalogSyncWaitMs": 50000 },

  "server": { "publicUrl": "http://127.0.0.1:4000", "apiKey": "${DT_API_KEY}", "ratePerSec": 1 }
}
