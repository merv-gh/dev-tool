{
  "dev": {
    "envFile": ".env.dev",
    "pg": {
      "orders": "DATABASE_URL_ORDERS",
      "billing": ["DATABASE_URL_BILLING", "DATABASE_URL_PAYMENTS"]
    },
    "defaultDb": "orders",
    "es": { "hosts": ["http://es-dev:9200"], "hostsVar": "ELASTICSEARCH_HOSTS", "userVar": "ELASTICSEARCH_USER", "passVar": "ELASTICSEARCH_PASS" },
    "kafkaUi": { "url": "http://kafka-ui-dev:8080", "var": "KAFKA_UI_URL" },
    "schemaRegistry": { "url": "http://schema-registry-dev:8081", "var": "SCHEMA_REGISTRY_URL" },
    "consul": { "url": "http://consul-dev:8500", "var": "CONSUL_URL" },
    "logs": {
      "index": "logs-*",
      "fields": { "time": "@timestamp", "message": "message", "service": "service.name", "level": "log.level", "trace": "trace.id" }
    }
  },
  "uat": {
    "envFile": ".env.uat",
    "pg": "auto"
  }
}
