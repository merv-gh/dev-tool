{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dt:tool-request:v1",
  "title": "dt.tool/v1 request",
  "type": "object",
  "required": [
    "protocol",
    "requestId",
    "tool",
    "arguments"
  ],
  "properties": {
    "protocol": {
      "const": "dt.tool/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "description": "Trusted server-generated scope carrier. A multi-user adapter must authenticate the service token, enforce both principal and story ownership on every resource, and propagate request cancellation. Tool arguments never choose this scope.",
      "required": [
        "principalId",
        "storyId",
        "scopeKey"
      ],
      "properties": {
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "storyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scopeKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "executionId": {
          "type": "string",
          "maxLength": 160
        },
        "revision": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
