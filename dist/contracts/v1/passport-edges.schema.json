{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:dev-tool:passport-edges:v1", "title": "Versioned passport edge projection",
  "description": "Adapter for persisted effective.consumes/produces/calls/endpoints. Known environment mismatches are excluded; unknown environment/revision and retained stale evidence must remain gaps.",
