{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dt:api-exchange:1",
  "title": "Sanitized API exchange v1",
  "description": "Portable evidence. Captured values are observations; absent bodies and ambiguous handlers remain explicit gaps. Transport adapters may add fields without changing version 1 semantics.",
  "type": "object",
  "required": ["schema", "version", "id", "at", "source", "request", "response", "timing", "route", "params", "redactions", "gaps"],
  "properties": {
    "schema": {"const": "dt.api-exchange"}, "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "at": {"type": "string", "format": "date-time"},
    "source": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string"}, "session": {"type": "string"}, "site": {"type": "string"}, "note": {"type": "string"}}},
    "request": {"$ref": "#/$defs/request"},
    "response": {"type": "object", "required": ["status", "headers", "body"], "properties": {"status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}, "statusText": {"type": "string"}, "headers": {"$ref": "#/$defs/headers"}, "body": {"$ref": "#/$defs/body"}}},
    "timing": {"type": "object", "properties": {"durationMs": {"type": ["number", "null"], "minimum": 0}}},
    "route": {"type": "object", "required": ["status", "candidates"], "properties": {"status": {"enum": ["unknown", "observed", "matched", "ambiguous"]}, "candidates": {"type": "array", "items": {"type": "object", "required": ["service", "method", "path", "handler", "where"], "properties": {"service": {"type": "string"}, "method": {"type": "string"}, "path": {"type": "string"}, "handler": {"type": "string"}, "where": {"type": "string"}, "source": {"type": "string"}}}}}},
    "params": {"type": "object", "additionalProperties": {"type": "object", "properties": {"type": {"type": "string"}, "required": {"type": "boolean"}, "secret": {"type": "boolean"}, "description": {"type": "string"}}}},
    "redactions": {"type": "array", "items": {"type": "object", "required": ["location", "reason"], "properties": {"location": {"type": "string"}, "reason": {"type": "string"}, "param": {"type": "string"}}}},
    "gaps": {"type": "array", "items": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string"}, "reason": {"type": "string"}}}}
  },
  "$defs": {
    "headers": {"type": "object", "additionalProperties": {"type": "string"}},
    "body": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["none", "json", "text", "form", "binary", "unsupported", "unavailable"]}, "value": {}, "contentType": {"type": "string"}, "bytes": {"type": "number", "minimum": 0}, "reviewed": {"type": "boolean"}, "reason": {"type": "string"}}},
    "request": {"type": "object", "required": ["method", "url", "headers", "body"], "properties": {"method": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]}, "url": {"type": "string"}, "headers": {"$ref": "#/$defs/headers"}, "body": {"$ref": "#/$defs/body"}}}
  }
}
