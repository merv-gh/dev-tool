# Personal tokens and compose settings: copy to .env.personal. Only dt reads the tokens.

# Bitbucket Server / Data Center (HTTP access token: Profile > Manage account > HTTP access tokens, read scope)
BITBUCKET_URL=
BITBUCKET_HTTP_TOKEN=

# Confluence. Cloud: CONFLUENCE_USERNAME=email + API token. Server/DC: leave USERNAME empty, token = personal access token.
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Group prefixes of your own Maven/Gradle libraries, comma separated (passports fetch these libraries too).
# Empty: libraries sharing the service's own group prefix count as internal.
INTERNAL_GROUPS=

# Which parts of docker-compose.yml to run, besides the dt tool server itself:
#   webui    Open WebUI chat (+ one-shot setup)      browser  Playwright MCP      graph  code-review-graph
# Already running Open WebUI? Leave webui out and see README "Use your own Open WebUI".
COMPOSE_PROFILES=webui,browser,graph

# LLM for the bundled Open WebUI: OpenAI-compatible with tool calling
LLM_BASE_URL=http://llm.internal:8000/v1
LLM_API_KEY=
LLM_MODEL=

# Optional: require this key from anything that is not this machine (Authorization: Bearer <key>).
# Set it when dt is reachable from other hosts, e.g. an Open WebUI elsewhere.
# DT_API_KEY=
